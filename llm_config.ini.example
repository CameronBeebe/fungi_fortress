[LLM]
# === API KEY CONFIGURATION ===
# API keys are loaded from environment variables for security
# Set this environment variable in your shell or .env file:
#
# For XAI (Grok):     export XAI_API_KEY="your-xai-api-key-here"
#
# If no XAI_API_KEY is set, the game will use a deterministic mock provider
# for offline play (Oracle will give pre-scripted responses based on keywords)

# === CONFIGURATION OPTIONS ===
# All defaults are defined in LLMConfig dataclass in fungi_fortress/config_manager.py
# Uncomment any line below to override the default

# Default model (see config_manager.py LLMConfig for current default):
# model_name = grok-4.3

# XAI reasoning effort (quality vs speed tradeoff):
# Options: none, low, medium, high
# Oracle uses low by default; world generation may adjust per-call
# reasoning_effort = low

# Sampling temperature (0.0-2.0, lower = more focused):
# temperature = 0.7

# Context detail level for game state information:
# Options: low, medium, high
# context_level = medium

# === COST CONTROL & SAFETY SETTINGS ===
# All these have safe defaults in LLMConfig - uncomment to customize

# Maximum tokens per response:
# max_tokens = 500

# API request timeout in seconds:
# timeout_seconds = 30

# Maximum retry attempts on failure:
# max_retries = 2

# Enable XAI structured outputs:
# enable_structured_outputs = true

# Enable streaming responses:
# enable_streaming = true
